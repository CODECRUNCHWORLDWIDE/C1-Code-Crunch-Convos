# .env.example — commit THIS file; put real values in .env and never commit that.
#
# Open-Meteo's free tier needs no key at all, which is why this project runs
# straight after `pip install`. The variable exists only for the optional
# commercial-tier stretch goal; leave it empty and everything still works.
OPEN_METEO_API_KEY=

# Not used by weather.py. Present because Challenge 02 in the same week reads
# it, and one .env per week is easier to keep straight than one per script.
GITHUB_TOKEN=
