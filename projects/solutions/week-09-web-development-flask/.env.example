# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Generate a real key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-secrets-token-hex

# Homework problem 6's demo password. Defaults to "letmein" when unset.
ADMIN_PASSWORD=letmein

# Open-Meteo's free tier needs no key. Leave blank unless you are on the
# commercial tier.
OPEN_METEO_API_KEY=
